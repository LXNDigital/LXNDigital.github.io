<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:lxnem="https://lxndigital.com/ns/emissions/1.0"
    targetNamespace="https://lxndigital.com/ns/emissions/1.0"
    elementFormDefault="qualified"
    attributeFormDefault="unqualified"
    version="1.0.1"
    id="LXNDigital_Emissions_1_0_1">

  <xs:annotation>
    <xs:documentation xml:lang="en">
      Emissions Schema V1.0.1, maintained by LXNDigital for voluntary global
      business use as an optional extension to an EPCIS event. This edition is
      a final publication candidate; its publication date is assigned when the
      controlled artefacts are released.
